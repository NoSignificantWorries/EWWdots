(deflisten thumbnails :initial ""
    "./scripts/wallpaper_thumbnails.sh"
)

(defwidget wallpaper-picker[]
    (box
        :orientation "vertical"
        :class "wallpaper-picker"
        (label
            :text "Select Wallpaper"
            :class "title"
        )
        (literal
            :content thumbnails
        )
        (button
            :class "apply-button"
            :onclick "./scripts/change_wallpaper.sh"
            "Apply"
        )
    )
)

(defwindow wallpaper-picker
    :monitor 0
    :geometry (geometry
        :width 500
        :height 300
        :anchor "center"
        :title "Wallpaper picker")
    :stacking "fg"
    :resizeable false
    :namespace "wallpaper-picker"
    (wallpaper-picker)
)
