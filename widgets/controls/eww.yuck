(defvar eww "~/.config/eww/widgets/controls")

(defpoll volume :interval "1s" `wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2*100}'`)
(defvar volume-update `wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%`)

(defpoll brightness :interval "2s" `brightnessctl -m | cut -d ',' -f4 | tr -d '%'`)
(defvar brightness-update `brightnessctl s {}%`)

(defvar volume-state false)
(defvar brightness-state false)

(defwidget slider-block [rev-name rev-state class label value onchange transition]
  (eventbox
    :onhover "sleep 0.5 | eww update -c ${eww} ${rev-name}=true"
    :onhoverlost "sleep 1 | eww update -c ${eww} ${rev-name}=false"
    (box
      :orientation "h"
      :space-evenly false
      :hexpand true
      :halign "end"
      (revealer
        :transition {transition}
        :duration 300
        :reveal {rev-state}
        (box
          :class "content"
          :orientation "v"
          :valign "center"
          :space-evenly false
          (label :class {class} :text "${label}${value}%")
          (box
            :orientation "v"
            :space-evenly false
            :class "${class}-slider"
            (scale
              :orientation "v"
              :flipped true
              :value {value}
              :onchange {onchange}
              :max 101
              :min 0
            )
          )
        )
      )
    )
  )
)

(defwidget volume-content []
  (slider-block
    :rev-name "volume-state"
    :rev-state {volume-state}
    :class "volume"
    :label " "
    :value {volume}
    :onchange {volume-update}
    :transition "slideleft"
  )
)

(defwidget brightness-content []
  (slider-block
    :rev-name "brightness-state"
    :rev-state {brightness-state}
    :class "brightness"
    :label "󰃟 "
    :value {brightness}
    :onchange {brightness-update}
    :transition "slideright"
  )
)


(defwindow volume-window
  :monitor 0
  :windowtype "normal"
  :geometry (geometry
    :y "3%"
    :x "0px"
    :width "6px"
    :height "100px"
    :anchor "right top"
  )
  :resizable false
  (eventbox
    :onhover "sleep 0.5 | eww update -c ${eww} volume-state=true"
    :onhoverlost "sleep 1 | eww update -c ${eww} volume-state=false"
    (volume-content)
  )
)

(defwindow brightness-window
  :monitor 0
  :windowtype "normal"
  :geometry (geometry
    :y "3%"
    :x "0px"
    :width "6px"
    :height "100px"
    :anchor "left top"
  )
  :resizable false
  (eventbox
    :onhover "sleep 0.5 | eww update -c ${eww} brightness-state=true"
    :onhoverlost "sleep 1 | eww update -c ${eww} brightness-state=false"
    (brightness-content)
  )
)

