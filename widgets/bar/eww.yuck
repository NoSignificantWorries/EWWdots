(defwidget sys-group []
    (box
        :class "sys-group"
        :orientation "h"
        (button
            :class "dashboard-button"
        )
    )
)

(defwidget power-group []
    (box
        :class "power-group"
        :orientation "h"
        (label
            :class "Text2"
            :text "Test2"
        )
    )
)

(defwidget layout []
    (box
        :class "layout"
        :orientation "h"
        (sys-group)
        (power-group)
    )
)

(defwindow bar
    :exclusive true
    :monitor 0
    :windowtype "dock"
    :namespace "bar"
    :stacking "fg"
    :focusable false
    :geometry (geometry
        :x "0%"
        :y "0%"
        :width "100%"
        :height "60px"
        :anchor "top center")
    :reserve (struts :side "top" :distance "60")
    (layout)
)
