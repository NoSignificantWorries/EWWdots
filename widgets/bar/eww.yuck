(defvar revealer-state false)

(defwidget sys-group []
    (box
        :class "sys-group"
        :orientation "h"
        (button
            :class "dashboard-button"
        )
    )
)

(defwidget reveal-group []
  (box
    :class "reveal-group"
    :orientation "h"
      (eventbox
        :onhover "eww update -c ~/.config/eww/widgets/bar revealer-state=true"
        :onhoverlost "eww update -c ~/.config/eww/widgets/bar revealer-state=false"
        :hexpand false
        :vexpand false
        (box
          :orientation "v"
            (revealer
              :transition "slidedown"
              :duration 500
              :reveal {revealer-state}  ; Связываем с переменной
              :identity "my_revealer"
              (box
                :orientation "vertical"
                :spacing 5
                :hexpand true
                :vexpand true
                ; Контент раскрытой части
                (label :text "Содержимое виджета 1")
                (label :text "Содержимое виджета 1")
                (label :text "Содержимое виджета 1")
                (label :text "Содержимое виджета 1")
                (label :text "Содержимое виджета 1")
                ; ...
              )
            )
        )
      )
  )
)

(defwidget power-group []
    (box
        :class "power-group"
        :orientation "h"
        (label
            :class "Text2"
            :text "Test2"
        )
    )
)

(defwidget layout []
    (box
        :class "layout"
        :orientation "h"
        (sys-group)
        (reveal-group)
        (power-group)
    )
)

(defwindow bar
    :exclusive true
    :monitor 0
    :windowtype "dock"
    :namespace "bar"
    :stacking "fg"
    :focusable false
    :geometry (geometry
        :x "0%"
        :y "0%"
        :width "100%"
        :height "60px"
        :anchor "top center")
    :reserve (struts :side "top" :distance "60")
    (layout)
)
