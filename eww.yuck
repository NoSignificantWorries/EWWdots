(include "/home/dmitry/.config/eww/widgets/test.yuck")
(include "/home/dmitry/.config/eww/widgets/test02.yuck")

(defwindow wallpaper-picker#esc
    :monitor 0
    :geometry (geometry
        :width 500
        :height 300
        :anchor "center"
        :title "Wallpaper picker")
    :stacking "fg"
    :resizable false
    :namespace "wallpaper-picker"
    (wallpaper-picker-widget)
)

(defwindow data-structures
  :monitor 0
  :geometry (geometry
    :anchor "center"
  )
  :stacking "fg"
  :resizable false
  (layout)
)


(defwindow time-window
  :monitor 0
  :geometry (geometry
    :y "35%"
    :x "0%"
    :width 100
    :height 80
    :anchor "top center"
  )
  :resizable false
  (label
    :text "Select Wallpaper"
    :class "title"
  )
)

(defwindow battery-window
  :monitor 0
  :geometry (geometry
    :y "45%"
    :x "40%"
    :width 100
    :height 80
    :anchor "top left"
  )
  :resizable false
  (label
    :text "Battery"
    :class "title"
  )
)

(defwindow workspace-window
  :monitor 0
  :geometry (geometry
    :y "45%"
    :x "40%"
    :width 100
    :height 80
    :anchor "top right"
  )
  :resizable false
  (label
    :text "Workspace"
    :class "title"
  )
)
